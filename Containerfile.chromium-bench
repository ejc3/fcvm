# Chromium CDP benchmark container: warm headless browser + in-guest fixture server.
#
# The shared-nothing bench snapshots this container AFTER warmup (renderer, JIT,
# network service, raster/encode all hot — the READY marker / the pageserver's
# /ready endpoint flag the warm point), then fans out file-backed clones that
# each drive one CDP render via bench/chromium/render.py.
#
# Build (repo root context; .dockerignore excludes target/):
#   podman build --format docker -t localhost/chromium-bench -f Containerfile.chromium-bench .
#
# --format docker is LOAD-BEARING. podman's default OCI format DROPS the
# HEALTHCHECK at the bottom of this file with only a warning
# ("HEALTHCHECK is not supported for OCI image format and will be ignored")
# and exits 0. fcvm then sees no healthcheck, and src/health.rs treats a
# MISSING one as a PASS (`None => HealthStatus::Healthy`), so the golden
# snapshot fires on "container is running" — a COLD browser — and every
# restored clone's "warm" latency is really a first-paint number. Verify:
#   podman inspect localhost/chromium-bench --format '{{json .HealthCheck}}'
# must print the Test array containing health_state.sh (the cheap reader;
# the CDP round trip itself is done by the resident cdp_health.py --loop).
#
# Host smoke test (fast loop, no VM):
#   podman run -d --name cb localhost/chromium-bench
#   podman logs -f cb          # wait for CHROMIUM_BENCH_READY
#   podman exec cb python3 /opt/bench/render.py http://127.0.0.1:8000/medium.html \
#       --out-prefix /tmp/medium
#
# Run with fcvm (rootless):
#   fcvm podman run --name chromium-bench localhost/chromium-bench
#   fcvm exec --pid <PID> -c -- python3 /opt/bench/render.py \
#       http://127.0.0.1:8000/medium.html --out-prefix /tmp/medium
#
# Golden-snapshot warm point: SUPERSEDED — do NOT pass a --health-check URL.
# An earlier recipe here suggested `--health-check http://127.0.0.1:8000/ready`.
# That sets `has_http_check` in src/health.rs, which SKIPS the podman HEALTHCHECK
# entirely — i.e. it disables the CDP round-trip gate defined at the bottom of
# this file, which is the trigger this design actually relies on. Leave
# --health-check UNSET so fcvm's AND-logic consults the image's HEALTHCHECK.
#
# Fixtures live in bench/chromium/pages/ and are COPY'd in; the host-side
# fixture server (bench harness) serves the SAME directory so in-guest and
# host-served arms render identical bytes.

FROM docker.io/library/debian:bookworm-slim

# chromium: the browser under test (Debian ships arm64 builds)
# python3: CDP driver (render.py) + fixture pageserver — no node/puppeteer bloat
# fonts-dejavu-core: deterministic text rendering (slim base has no fonts -> tofu)
# The trailing rm also drops /var/cache/apt/archives/partial (_apt-owned, mode
# 0700): rootless fcvm packs the image store with an unprivileged mkfs.ext4 -d
# outside the user namespace, and any non-root-owned dir without world rx makes
# that fail with "__populate_fs: Permission denied".
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    python3 \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/partial

# Belt-and-braces half of the getenv/setenv workaround documented at length in
# bench/chromium/entry.sh. entry.sh exports this too, but the bench also drives
# this image with `--entrypoint python3 <driver>`, which never runs entry.sh --
# putting the name in the image environment means no entrypoint can lose it.
# Any value would defuse the race (glibc only reallocs the environ array for a
# name it has never seen); this is the exact string ANGLE composes, so nothing
# observes a different ICD path than it would have anyway. To reproduce the
# original crash for a regression test, run a non-entry.sh entrypoint with
# `--unsetenv VK_ICD_FILENAMES` (entry.sh deliberately re-exports it, and
# `-e VK_ICD_FILENAMES=` does NOT work -- an empty value still counts as
# present, so glibc still slot-replaces; measured 0/12 under the amplifier).
ENV VK_ICD_FILENAMES=/usr/lib/chromium/./vk_swiftshader_icd.json

COPY bench/chromium/pages/ /opt/bench/pages/
COPY bench/chromium/pageserver.py bench/chromium/render.py bench/chromium/entry.sh \
     bench/chromium/cdp_health.py bench/chromium/health_loop.py \
     bench/chromium/health_state.sh /opt/bench/
RUN chmod +x /opt/bench/entry.sh /opt/bench/render.py /opt/bench/pageserver.py \
     /opt/bench/cdp_health.py /opt/bench/health_state.sh

# The request path IS Chromium's DevTools Protocol endpoint -- no wrapper of
# ours parses, re-encodes or re-frames a single CDP message:
#
#   Chromium IGNORES --remote-debugging-address on this build (151.0.7922.71,
#   Debian bookworm arm64). Verified, not assumed: the flag is present in
#   /proc/<pid>/cmdline while /proc/net/tcp shows 0100007F:2406 (127.0.0.1:9222)
#   and nothing else -- in the same container where the page server's
#   00000000:1F40 proves a wildcard bind works fine. It is Chromium, not us.
#
#   fcvm publishes eligible TCP ports through fc-agent's PREROUTING DNAT to
#   guest loopback. `--publish 9222:9222` therefore reaches Chromium directly.
#   `--forward-localhost` remains the opposite direction (guest -> host) and
#   cannot be combined with the same guest port.
#
# Clones inherit the published port from snapshot metadata. There is no
# benchmark-owned relay or request server in the guest byte path.
EXPOSE 9222

# fcvm's health gate is the golden-snapshot trigger. With no `--health-check`
# URL, `Healthy` = container running AND podman's HEALTHCHECK healthy
# (src/health.rs, "AND logic"), so THIS is what decides when the snapshot is
# taken. The resident cdp_health.py --loop requires a warm marker AND a live
# CDP round trip that
# finds a page target: healthy means provably able to screenshot.
# start-period covers Chromium's cold launch + the warm render; interval is the
# resolution of the snapshot trigger, so it is short.
# The check itself is a file read: cdp_health.py --loop is resident (started by
# entry.sh) and publishes its verdict; this reads it and demands FRESH healthy.
# As a per-second HEALTHCHECK the python form cost a fresh interpreter in every
# clone forever: 9.1ms startup, 43.6ms for the whole check, measured in this
# image. Resident, that cost is paid once at the golden and its dirtied pages
# are shared by every clone.
HEALTHCHECK --interval=1s --timeout=5s --start-period=90s --retries=3 \
    CMD ["/opt/bench/health_state.sh"]

CMD ["/opt/bench/entry.sh"]
