+	accept_attach_connection(fd, (struct remote_sock_s *)user_data);
+	return G_SOURCE_CONTINUE;
+}
+
+/*
+ * Accept the attach connections already queued, for when the main loop quit
+ * before dispatching attach_cb. Output is relayed only to accepted
+ * connections, and a connection still queued when conmon exits is reset, so
+ * the client reads neither output nor an error.
+ */
+void accept_queued_attach_connections(void)
+{
+	int accepted = 0;
+	if (remote_attach_sock.fd < 0)
+		return;
+	while (accept_attach_connection(remote_attach_sock.fd, &remote_attach_sock))
+		accepted++;
+	if (accepted > 0)
+		ndebugf("accepted %d attach connection%s after the runtime exited", accepted, accepted == 1 ? "" : "s");
+}
+
+/* Returns TRUE when it accepted a connection. */
+static gboolean accept_attach_connection(int fd, struct remote_sock_s *srcsock)
+{
 	int new_fd = accept(fd, NULL, NULL);
 	if (new_fd == -1) {
 		if (errno != EWOULDBLOCK)
 			nwarn("Failed to accept client connection on attach socket");
-	} else {
-		struct remote_sock_s *remote_sock;
-		set_socket_buffers(new_fd);
-		if (srcsock->dest->readers == NULL) {
-			srcsock->dest->readers = g_ptr_array_new_with_free_func(free);
-		}
-		remote_sock = malloc(sizeof(*remote_sock));
-		if (remote_sock == NULL) {
-			pexit("Failed to allocate memory");
-		}
-		init_remote_sock(remote_sock, srcsock);
-		remote_sock->fd = new_fd;
-		g_unix_fd_add(remote_sock->fd, G_IO_IN | G_IO_HUP | G_IO_ERR, remote_sock_cb, remote_sock);
-		g_ptr_array_add(remote_sock->dest->readers, remote_sock);
-		ndebugf("Accepted%s connection %d", SOCK_IS_CONSOLE(srcsock->sock_type) ? " console" : "", remote_sock->fd);
+		return FALSE;
 	}
-
-	return G_SOURCE_CONTINUE;
+	struct remote_sock_s *remote_sock;
+	set_socket_buffers(new_fd);
+	if (srcsock->dest->readers == NULL) {
+		srcsock->dest->readers = g_ptr_array_new_with_free_func(free);
+	}
+	remote_sock = malloc(sizeof(*remote_sock));
+	if (remote_sock == NULL) {
+		pexit("Failed to allocate memory");
+	}
+	init_remote_sock(remote_sock, srcsock);
+	remote_sock->fd = new_fd;
+	g_unix_fd_add(remote_sock->fd, G_IO_IN | G_IO_HUP | G_IO_ERR, remote_sock_cb, remote_sock);
+	g_ptr_array_add(remote_sock->dest->readers, remote_sock);
+	ndebugf("Accepted%s connection %d", SOCK_IS_CONSOLE(srcsock->sock_type) ? " console" : "", remote_sock->fd);
+	return TRUE;
 }
 
