 {
@@ -340,8 +341,9 @@ int main(int argc, char *argv[])
 	if (seccomp_listener != NULL)
 		g_unix_fd_add(seccomp_socket_fd, G_IO_IN, seccomp_accept_cb, csname);
 
+	guint console_watch = 0;
 	if (csname != NULL) {
-		g_unix_fd_add(console_socket_fd, G_IO_IN, terminal_accept_cb, csname);
+		console_watch = g_unix_fd_add(console_socket_fd, G_IO_IN, terminal_accept_cb, csname);
 		/* Process any SIGCHLD we may have missed before the signal handler was in place.  */
 		if (!opt_exec || !opt_terminal || container_status < 0) {
 			GHashTable *exit_status_cache = g_hash_table_new_full(g_int_hash, g_int_equal, g_free, g_free);
@@ -385,6 +387,37 @@ int main(int argc, char *argv[])
 		nexitf("Failed to create container: exit status %d", get_exit_status(runtime_status));
 	}
 
+	/*
+	 * The runtime connects to the console socket and sends the terminal
+	 * before it exits, but the main loop can still quit without accepting
+	 * it. Any callback that reaps children (the initial child check, or a
+	 * SIGCHLD from an exec'd process that exited and was reparented to us)
+	 * calls waitpid() after the poll that scheduled it. If the runtime
+	 * connected and exited in between, runtime_exit_cb quits the loop while
+	 * the connection sits in the listen queue, unseen by that poll. Accept
+	 * it now rather than failing an exec whose process already ran.
+	 */
+	if (opt_terminal && mainfd_stdout == -1 && console_watch != 0) {
+		struct pollfd pending = {.fd = console_socket_fd, .events = POLLIN};
+		int ready;
+		do
+			ready = poll(&pending, 1, 0);
+		while (ready < 0 && errno == EINTR);
+		if (ready > 0) {
+			ndebug("accepting the console after the runtime exited");
+			g_source_remove(console_watch);
+			terminal_accept_cb(console_socket_fd, G_IO_IN, csname);
+			/*
+			 * The loop missed the attach connection for the same
+			 * reason: the client connected before the runtime
+			 * started. If the process has also exited, the loop
+			 * below does not run, and output drained to no
+			 * accepted connection is lost.
+			 */
+			accept_queued_attach_connections();
+		}
+	}
+
 	if (opt_terminal && mainfd_stdout == -1)
 		nexit("Runtime did not set up terminal");
 
