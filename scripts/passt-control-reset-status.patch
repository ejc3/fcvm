index 794a9d8..4f741d8 100644
--- a/pesto.h
+++ b/pesto.h
@@ -25,6 +25,13 @@
 #define PESTO_VERSION_STATUS	3
 #define PESTO_PROTOCOL_VERSION	3
 
+/* Sent by a client in place of a pif id, before the tables: also forget the guest.
+ * The server closes every flow and takes back the guest addresses it learned from
+ * traffic, so the next guest on the same tap sees nothing of the last one's. The
+ * status byte (see enum pesto_status) is then sent once every flow is closed.
+ */
+#define PESTO_RESET		0xff
+
 /* Maximum size of a pif name, including \0 */
