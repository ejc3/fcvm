--- a/conf.c
+++ b/conf.c
@@ -2091,6 +2091,33 @@ void conf(struct ctx *c, int argc, char **argv)
 
 static void conf_accept(struct ctx *c);
 
+/* What passt knew of the guest before any traffic, kept by conf_guest_save() for
+ * a PESTO_RESET to put back
+ */
+static struct {
+	unsigned char mac[ETH_ALEN];
+	struct in_addr addr4;
+	struct in6_addr addr6, addr6_ll;
+} conf_guest;
+
+/* A reset was asked for and conf_defer_handler() has not finished it */
+static bool conf_reset_wanted;
+
+/* Status byte owed to the control client once the reset is finished, or -1 */
+static int conf_reset_status = -1;
+
+/**
+ * conf_guest_save() - Record the guest addresses configured at start
+ * @c:		Execution context
+ */
+void conf_guest_save(const struct ctx *c)
+{
+	memcpy(conf_guest.mac, c->guest_mac, ETH_ALEN);
+	conf_guest.addr4 = c->ip4.addr_seen;
+	conf_guest.addr6 = c->ip6.addr_seen;
+	conf_guest.addr6_ll = c->ip6.addr_ll_seen;
+}
