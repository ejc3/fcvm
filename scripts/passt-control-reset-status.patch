  * conf_send_rules() - Send current forwarding rules to config client (pesto)
  * @c:		Execution context
@@ -2141,10 +2168,11 @@ static int conf_send_rules(const struct ctx *c, int fd)
  * conf_recv_rules() - Receive forwarding rules from configuration client
  * @c:		Execution context
  * @fd:		Socket to the client
+ * @reset:	Set if the client also asked to forget the guest (PESTO_RESET)
  *
  * Return: 0 on success, -1 on failure
  */
-static int conf_recv_rules(const struct ctx *c, int fd)
+static int conf_recv_rules(const struct ctx *c, int fd, bool *reset)
 {
 	while (1) {
 		struct fwd_table *fwd;
@@ -2159,6 +2187,11 @@ static int conf_recv_rules(const struct ctx *c, int fd)
 		if (pif == PIF_NONE)
 			break;
 
+		if (pif == PESTO_RESET) {
+			*reset = true;
+			continue;
+		}
+
 		if (pif >= ARRAY_SIZE(c->fwd_pending) ||
 		    !(fwd = c->fwd_pending[pif])) {
 			err("Received rules for non-existent table");
@@ -2205,6 +2238,38 @@ static void conf_close(struct ctx *c)
 	c->fd_control = -1;
 }
 
+/**
+ * conf_defer_handler() - Finish a reset once its flows are closed
+ * @c:		Execution context
+ *
+ * Runs after flow_defer_handler(). Puts back the guest addresses passt started
+ * with, in place of the ones it learned from the last guest's traffic, then
+ * sends the client its status.
+ */
+void conf_defer_handler(struct ctx *c)
+{
+	if (!conf_reset_wanted || !flow_reset_done())
+		return;
+	conf_reset_wanted = false;
+
+	memcpy(c->guest_mac, conf_guest.mac, ETH_ALEN);
+	proto_update_l2_buf(c->guest_mac);
+	c->ip4.addr_seen = conf_guest.addr4;
+	c->ip6.addr_seen = conf_guest.addr6;
+	c->ip6.addr_ll_seen = conf_guest.addr6_ll;
+	info("Reset: flows closed, guest addresses as at start");
+
+	if (conf_reset_status < 0)
+		return;		/* The client hung up: conf_handler() closed it */
+
+	if (write_u8(c->fd_control, conf_reset_status) < 0)
+		debug("Configuration client left before its status");
+	conf_reset_status = -1;
+
+	conf_close(c);
+	conf_accept(c);
+}
+
 /**
  * conf_listen_handler() - Handle events on configuration listening socket
  * @c:		Execution context
@@ -2240,6 +2305,7 @@ static void conf_accept(struct ctx *c)
 		.ifnamsiz = htonl(IFNAMSIZ),
 	};
 	union epoll_ref ref = { .type = EPOLL_TYPE_CONF };
+	const struct timeval tv = { .tv_sec = 1 };
 	struct ucred uc = { 0 };
 	socklen_t len = sizeof(uc);
 	int fd, rc;
@@ -2262,6 +2328,16 @@ retry:
 	if (getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &uc, &len) < 0)
 		warn_perror("Can't get configuration client credentials");
 
+	/* The transaction is synchronous (see above), so a client that sends
+	 * part of a message would hold the forwarding loop in a read. Each
+	 * read and write on this socket gives up after a second instead: the
+	 * transaction fails and the connection is closed. This bounds one
+	 * call, not a whole message.
+	 */
+	if (setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv)) ||
+	    setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv)))
+		warn_perror("Can't bound configuration socket reads and writes");
+
 	c->fd_control = ref.fd = fd;
 	rc = epoll_add(c->epollfd, EPOLLIN | EPOLLET, ref);
 	if (rc < 0) {
@@ -2298,8 +2374,19 @@ fail:
  */
 void conf_handler(struct ctx *c, uint32_t events)
 {
+	if (conf_reset_status >= 0) {
+		/* A reset's reply is owed, by conf_defer_handler(). A client that
+		 * hung up meanwhile gets none; the reset happens all the same.
+		 */
+		if (!(events & (EPOLLHUP | EPOLLERR)))
+			return;
+		conf_reset_status = -1;
+		goto close;
+	}
+
 	if (events & EPOLLIN) {
 		enum pesto_status status = PESTO_STATUS_OK;
+		bool reset = false;
 		unsigned pif;
 
 		/* Clear pending tables */
@@ -2309,7 +2396,7 @@ void conf_handler(struct ctx *c, uint32_t events)
 		/* FIXME: this could block indefinitely if the client doesn't
 		 * write as much as it should
 		 */
-		if (conf_recv_rules(c, c->fd_control) < 0)
+		if (conf_recv_rules(c, c->fd_control, &reset) < 0)
 			goto close;
 
 		for (pif = 0; pif < PIF_NUM_TYPES; pif++) {
@@ -2334,6 +2421,13 @@ void conf_handler(struct ctx *c, uint32_t events)
 			}
 		}
 
+		if (reset) {
+			flow_reset();
+			conf_reset_wanted = true;
+			conf_reset_status = status;
+			return;
+		}
+
 		if (write_u8(c->fd_control, status) < 0)
 			warn_perror("Failed to write status on control socket");
 	}
