+/**
+ * flow_reset() - Close every flow at the next flow_defer_handler()
+ *
+ * Flows are closed there and not here because an event of the current epoll batch
+ * may still name one.
+ */
+void flow_reset(void)
+{
+	flow_reset_pending = true;
+}
+
+/**
+ * flow_reset_done() - Check whether a requested reset has closed every flow
+ *
+ * Return: true if no reset is pending
+ */
+bool flow_reset_done(void)
+{
+	return !flow_reset_pending;
+}
