 #define PESTO_PROTOCOL_VERSION	2
 
+/* Sent by a client in place of a pif id, before the tables: also forget the guest.
+ * The server closes every flow and takes back the guest addresses it learned from
+ * traffic, so the next guest on the same tap sees nothing of the last one's.
+ */
+#define PESTO_RESET		0xff
+
+/* After the client's tables, the server answers with one byte of these flags and
+ * closes the connection. For a PESTO_RESET the byte is sent once every flow is closed.
+ */
+#define PESTO_STATUS_LISTEN_FAILED	0x01	/* a rule could not be bound */
+
 /* Maximum size of a pif name, including \0 */
 #define	PIF_NAME_SIZE	(128)
 #define PIF_NONE	0
