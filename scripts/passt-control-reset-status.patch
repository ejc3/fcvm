+/**
+ * conf_defer_handler() - Finish a reset once its flows are closed
+ * @c:		Execution context
+ *
+ * Runs after flow_defer_handler(). Puts back the guest addresses passt started
+ * with, in place of the ones it learned from the last guest's traffic, then
+ * sends the client its status.
+ */
+void conf_defer_handler(struct ctx *c)
+{
+	if (!conf_reset_wanted || !flow_reset_done())
+		return;
+	conf_reset_wanted = false;
+
+	memcpy(c->guest_mac, conf_guest.mac, ETH_ALEN);
+	proto_update_l2_buf(c->guest_mac);
+	c->ip4.addr_seen = conf_guest.addr4;
+	c->ip6.addr_seen = conf_guest.addr6;
+	c->ip6.addr_ll_seen = conf_guest.addr6_ll;
+	info("Reset: flows closed, guest addresses as at start");
+
+	if (conf_reset_status < 0)
+		return;		/* The client hung up: conf_handler() closed it */
+
+	if (write_u8(c->fd_control, conf_reset_status) < 0)
+		debug("Configuration client left before its status");
+	conf_reset_status = -1;
+
+	conf_close(c);
+	conf_accept(c);
+}
+
