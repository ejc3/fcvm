Ends in: cpu0: run/in-guest tmr[en] sgi[en] L2 ICH_VMCR-lost; cpu1: run/in-guest tmr[en] sgi[en]; spi[en latch] device-waits; counter exact -/
def MutantRun.fcNoNestedIcc : List Label :=
  [.g false .l2, .pause, .save, .restore, .resume]

theorem mutant_fcNoNestedIcc_breaks :
    (replay Mutant.fcNoNestedIcc Cfg.nvL2 MutantRun.fcNoNestedIcc (init Cfg.nvL2)).map (lostNestedMask) = some true := by
  decide

theorem mutant_fcNoNestedIcc_not_sound : ¬ Sound Mutant.fcNoNestedIcc :=
  not_sound_of_run (C := Cfg.nvL2) (run := MutantRun.fcNoNestedIcc) (by decide)

/-- R3 timerLoops, `mutant-fc-resume-stops-vcpu1` in `plain`, 4 steps:
1. CPU 1 programs its tick timer one unit ahead
2. guest time passes
3. the VMM pauses the vCPUs
4. the VMM resumes the vCPUs

Ends in: cpu0: run/in-guest tmr[en] sgi[en]; cpu1: run/in-guest STOPPED tmr[en line] sgi[en] timer@1 tick-owed; spi[en]; counter exact -/
def MutantRun.fcResumeStopsVcpu1 : List Label :=
  [.g true .arm, .tick, .pause, .resume]

theorem mutant_fcResumeStopsVcpu1_breaks :
    (replay Mutant.fcResumeStopsVcpu1 Cfg.plain MutantRun.fcResumeStopsVcpu1 (init Cfg.plain)).map (timerLoops Cfg.plain) = some true := by
  decide

theorem mutant_fcResumeStopsVcpu1_not_sound : ¬ Sound Mutant.fcResumeStopsVcpu1 :=
  not_sound_of_run (C := Cfg.plain) (run := MutantRun.fcResumeStopsVcpu1) (by decide)

end Resume
