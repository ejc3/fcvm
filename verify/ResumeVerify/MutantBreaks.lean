import ResumeVerify.Mutants
import ResumeVerify.Proofs

/-!
# Every mutant has a break, and so is not sound

Generated by `gen-resume-breaks.py mutants` from `lake exe resume-breaks mutants traces`: do not
edit by hand. For each rule book of `Mutants.lean`, a shortest run to a break, replayed and
checked by `decide`, and from the same run that the mutant is not `Sound`.
-/

namespace Resume

set_option maxRecDepth 100000
/-- R1 lostIpi, `mutant-ch-slots-vcpu0` in `plain`, 5 steps:
1. CPU 0 sends a cross-call IPI to the other CPU and waits for it
2. the VMM pauses the vCPUs
3. the VMM saves the state
4. a new VM is restored from the image
5. the VMM resumes the vCPUs

Ends in: cpu0: run/in-guest tmr[en] sgi[en]; cpu1: run/in-guest tmr[en] sgi[en] call-owed; spi[en latch]; counter exact -/
def MutantRun.chSlotsVcpu0 : List Label :=
  [.g false .send, .pause, .save, .restore, .resume]

theorem mutant_chSlotsVcpu0_breaks :
    (replay Mutant.chSlotsVcpu0 Cfg.plain MutantRun.chSlotsVcpu0 (init Cfg.plain)).map (lostIpi) = some true := by
  decide

theorem mutant_chSlotsVcpu0_not_sound : ¬ Sound Mutant.chSlotsVcpu0 :=
  not_sound_of_run (C := Cfg.plain) (run := MutantRun.chSlotsVcpu0) (by decide)

