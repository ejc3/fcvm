#!/usr/bin/env bpftrace
// Per firecracker process, in 100 ms buckets from its vCPU's first stage-2 fault:
// stage-2 faults on guest memory and device (MMIO) aborts taken by the vCPU thread, and
// time any of its threads waited in handle_userfault. @device counts the device aborts
// of every guest by page. Buckets past 12 s are dropped.
//
// Run with BPFTRACE_MAX_MAP_KEYS=150000 (1000 clones x 120 buckets fit). The maps are
// per-CPU and preallocated, so on 192 CPUs each takes seconds to create: start the
// workload only after this prints "attached".
BEGIN { printf("attached\n"); }
tracepoint:kvm:kvm_guest_fault /comm == "fc_vcpu 0"/ {
  if (@t0[pid] == 0) { @t0[pid] = nsecs; }
  $b = (nsecs - @t0[pid]) / 100000000;
  if ($b < 120) {
    // Firecracker's arm64 guests have RAM from 2 GiB up; an abort below it is a device access.
    if (args->ipa >= 0x80000000) { @s2[pid, $b] = count(); } else { @mmio[pid, $b] = count(); }
  }
  if (args->ipa < 0x80000000) { @device[args->ipa & 0xfffffffffffff000] = count(); }
}
kprobe:handle_userfault /comm == "fc_vcpu 0" || strncmp(comm, "firecracker", 11) == 0 || comm == "fc_api"/ {
  @ufs[tid] = nsecs;
}
kretprobe:handle_userfault /@ufs[tid]/ {
  if (@t0[pid] != 0) {
    $b = (nsecs - @t0[pid]) / 100000000;
    if ($b < 120) { @ufns[pid, $b] = sum(nsecs - @ufs[tid]); @ufn[pid, $b] = count(); }
  }
  delete(@ufs[tid]);
}
tracepoint:sched:sched_process_exec { @execs = count(); }
tracepoint:sched:sched_process_fork { @forks = count(); }
