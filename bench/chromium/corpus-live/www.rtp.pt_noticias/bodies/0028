/* Accessible skip link: visible on focus */
.skip-link {
    position: absolute;
    top: 0;
    left: 0;
    transform: translateY(-200%);
    background: #ffffff;
    color: #000000;
    padding: 8px 12px;
    border-radius: 2px;
    outline: 2px solid #000;
    text-decoration: none;
    z-index: 10000;
}

.skip-link:focus,
.skip-link:active {
    transform: translateY(0);
}

