	// subscription change send tags
	function subscriptionChangeSetTag() {

		if (mainTag=="rtp-noticias"){
			var tagsToSend = {'rtp-noticias': true};
		}else if (mainTag=="rtp-play"){
			var tagsToSend = {'rtp-play': true};
