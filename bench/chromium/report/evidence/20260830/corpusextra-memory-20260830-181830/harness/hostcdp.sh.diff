@@ -99,8 +122,9 @@ log "warm marker up after $((SECONDS - t0))s; measuring $REPS reps ($WARMUP warm
 OUT="$RESULTS/hostcdp.jsonl"
 : > "$OUT"
 for rep in $(seq 0 $((REPS - 1))); do
