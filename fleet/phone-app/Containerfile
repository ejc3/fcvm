# Build container for Robot Park (fleet/phone-app): a JDK, Gradle at a pinned version and
# checksum, zip, and glslangValidator for the shader check. The Android tools are not in the
# image: the app's build (build-apk.sh) mounts the AOSP build's (scripts/phone/aosp.sh,
# read-only, at /aosp-tools), and the scene's tests need none. Dependencies resolve from
# Maven Central and the Gradle plugin portal, checked against gradle/verification-metadata.xml.
# `make -C fleet/phone-app` builds it.
FROM docker.io/library/ubuntu:24.04
RUN apt-get update -q && DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends \
      openjdk-17-jdk-headless curl ca-certificates unzip zip glslang-tools \
    && rm -rf /var/lib/apt/lists/*
ARG GRADLE_VERSION=8.10.2
ARG GRADLE_SHA256=31c55713e40233a8303827ceb42ca48a47267a0ad4bab9177123121e71524c26
# The Makefile fetches the distribution into .gradle-dist (make gradle-dist), so a host or CI
# cache that holds it builds this image without downloading it again.
COPY .gradle-dist/gradle-${GRADLE_VERSION}-bin.zip /tmp/gradle.zip
RUN echo "${GRADLE_SHA256}  /tmp/gradle.zip" | sha256sum -c - \
 && unzip -q /tmp/gradle.zip -d /opt && rm /tmp/gradle.zip \
 && ln -s "/opt/gradle-${GRADLE_VERSION}/bin/gradle" /usr/local/bin/gradle
# The debug signing key lives with the caches, so rebuilds on one host sign alike.
ENV GRADLE_USER_HOME=/gradle-home \
    ANDROID_USER_HOME=/gradle-home/android \
    GRADLE_OPTS="-Dorg.gradle.daemon=false -Dorg.gradle.welcome=never"
WORKDIR /src
