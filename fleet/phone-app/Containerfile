# Build container for Robot Park (fleet/phone-app): a JDK, Gradle at a pinned version and
# checksum, zip, and glslangValidator for the shader check. The Android tools are not in the
# image: the app's build (build-apk.sh) mounts the AOSP build's (scripts/phone/aosp.sh,
# read-only, at /aosp-tools), and the scene's tests need none. Dependencies resolve from
# Maven Central and the Gradle plugin portal, checked against gradle/verification-metadata.xml.
# `make -C fleet/phone-app` builds it.
FROM docker.io/library/ubuntu:24.04
# apt's Acquire::http::Timeout counts only time without data, so a connection that keeps
# trickling never trips it: in run 44504825691 one archive.ubuntu.com address served the JDK at
# 65 kB/s for 11 minutes while other runs fetched the same 133 MB in 2 to 49 s. So the index
# update and the package downloads each get a wall-clock bound per attempt and up to three
# attempts, each on a new connection. The downloads retry without another update: the image's
# docker-clean hook deletes downloaded and partial .debs after every update, and without it a
# retry fetches only what the previous attempt did not. Installing reads only the downloaded files.
RUN apt="apt-get -q -o Acquire::http::Timeout=30 -o Acquire::Retries=3" \
    pkgs="openjdk-17-jdk-headless curl ca-certificates unzip zip glslang-tools"; \
    retry() { \
      limit=$1 what=$2; shift 2; \
      for attempt in 1 2 3; do \
        timeout "$limit" "$@" && return 0; \
        echo "apt: $what attempt $attempt of 3 failed or ran out of its $limit s" >&2; \
      done; \
      return 1; \
    }; \
    retry 60 update $apt update \
    && retry 120 download $apt install -y --no-install-recommends --download-only $pkgs \
    && DEBIAN_FRONTEND=noninteractive $apt install -y --no-install-recommends $pkgs \
    && rm -rf /var/lib/apt/lists/*
ARG GRADLE_VERSION=8.10.2
ARG GRADLE_SHA256=31c55713e40233a8303827ceb42ca48a47267a0ad4bab9177123121e71524c26
# The Makefile fetches the distribution into .gradle-dist (make gradle-dist), so a host or CI
# cache that holds it builds this image without downloading it again.
COPY .gradle-dist/gradle-${GRADLE_VERSION}-bin.zip /tmp/gradle.zip
RUN echo "${GRADLE_SHA256}  /tmp/gradle.zip" | sha256sum -c - \
 && unzip -q /tmp/gradle.zip -d /opt && rm /tmp/gradle.zip \
 && ln -s "/opt/gradle-${GRADLE_VERSION}/bin/gradle" /usr/local/bin/gradle
# The debug signing key lives with the caches, so rebuilds on one host sign alike.
ENV GRADLE_USER_HOME=/gradle-home \
    ANDROID_USER_HOME=/gradle-home/android \
    GRADLE_OPTS="-Dorg.gradle.daemon=false -Dorg.gradle.welcome=never"
WORKDIR /src
