# The phone container: runs the Android Emulator (mapped at /emu) on the system image and adb
# built from AOSP source (mapped at /android), rendering on the VM's NVIDIA GPU (fcvm passes
# the GPU in as CDI devices, which mount the driver's libraries), and the phone streamer.
# `make -C fleet/phone image` builds it; scripts/phone/run.sh runs it, and a fleet slot runs
# `phone.sh serve` in it.
FROM docker.io/library/ubuntu:24.04 AS kvmprobe
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends gcc libc6-dev linux-libc-dev \
    && rm -rf /var/lib/apt/lists/*
COPY kvmprobe.c /src/kvmprobe.c
RUN gcc -O2 -static -Wall -Wextra -Werror -o /kvmprobe /src/kvmprobe.c

# The phone streamer (streamer/), built with the renderer's server, encoder and wire code
# from the `renderer` build context (fleet/renderer), which fleet/phone/Makefile passes.
FROM docker.io/nvidia/cuda:12.8.1-devel-ubuntu24.04 AS streamer
RUN apt-get update -q && apt-get install -y -q --no-install-recommends git ca-certificates make libssl-dev \
      pkg-config libgrpc++-dev libprotobuf-dev protobuf-compiler protobuf-compiler-grpc \
    && rm -rf /var/lib/apt/lists/*
# NVENC API header (MIT), pinned as the renderer pins it: n12.2.72.0
RUN git clone -q https://github.com/FFmpeg/nv-codec-headers.git /opt/nv-codec-headers \
    && git -C /opt/nv-codec-headers checkout -q c69278340ab1d5559c7d7bf0edf615dc33ddbba7
COPY --from=renderer src /src/renderer/src
COPY --from=renderer tests/check.h /src/renderer/tests/check.h
COPY streamer /src/phone/streamer
# test-host reads main.cpp beside it by a path relative to where it was compiled, so it runs
# from the streamer's directory.
RUN make -C /src/phone/streamer -j"$(nproc)" RSRC=/src/renderer/src RTESTS=/src/renderer/tests all \
    && cd /src/phone/streamer && build/test-host

FROM docker.io/library/ubuntu:24.04
# The emulator's own libraries cover most of what it loads; these are the system ones it
# links or dlopens (X client libraries even headless), glvnd's EGL and GLES dispatch, and
# the Vulkan loader.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libx11-6 libx11-xcb1 libxkbfile1 libegl1 libgl1 libgles2 libvulkan1 libpulse0 libnss3 \
      libxcomposite1 libxcursor1 libxi6 libxtst6 libxdamage1 libxrandr2 libasound2t64 libdbus-1-3 \
      libbsd0 libgbm1 libdrm2 libxext6 libxfixes3 libxrender1 libfontconfig1 libfreetype6 libsm6 \
      libice6 libxcb1 libxkbcommon0 libxkbcommon-x11-0 libnspr4 libexpat1 libuuid1 \
      iproute2 procps util-linux jq ca-certificates libssl3t64 libgrpc++1.51t64 libprotobuf32t64 \
    && rm -rf /var/lib/apt/lists/*
# glvnd and the Vulkan loader find NVIDIA's libraries (mounted by the CDI spec) through these.
RUN mkdir -p /usr/share/glvnd/egl_vendor.d /usr/share/vulkan/icd.d \
 && printf '{"file_format_version":"1.0.0","ICD":{"library_path":"libEGL_nvidia.so.0"}}\n' \
      > /usr/share/glvnd/egl_vendor.d/10_nvidia.json \
 && printf '{"file_format_version":"1.0.1","ICD":{"library_path":"libGLX_nvidia.so.0","api_version":"1.4.0"}}\n' \
      > /usr/share/vulkan/icd.d/nvidia_icd.json
COPY --from=kvmprobe /kvmprobe /usr/local/bin/kvmprobe
COPY --from=streamer /src/phone/streamer/build/phone-streamer /usr/local/bin/phone-streamer
COPY phone.sh /usr/local/bin/phone.sh
# fc-agent runs the hook to release the GPU before a warm snapshot and retake it after.
COPY gpu-hook /usr/local/bin/gpu-hook
LABEL dev.fcvm.gpu-hook=/usr/local/bin/gpu-hook
CMD ["sleep", "infinity"]
