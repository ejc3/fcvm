#!/bin/bash
# The phone container's GPU hook: the running phone lets go of the VM's GPU and takes it up
# again, through the emulator's console, while the phone keeps its state. The image label
# dev.fcvm.gpu-hook names it, and fc-agent runs it when it parks the VM's GPUs for a warm
# snapshot (release) and when it brings them up again in the source VM or in a clone
# (retake); `make phone-test` also runs it directly.
#
#   gpu-hook release   stops the phone streamer (phone.sh serve starts it again after the
#                      retake), then 'gpu release': the emulator pauses the phone, keeps its GPU state in
#                      memory and unloads the graphics driver, so it holds no /dev/nvidia*
#                      descriptor or mapping; prints released_ms
#   gpu-hook retake    'gpu retake': the emulator loads the driver, restores the state onto
#                      the GPU the VM has now and resumes the phone; then waits for the
#                      phone's next frame on that GPU and prints retaken_ms, first_frame_ms
#                      and first_frame_at_ms (the wall clock, in ms since the epoch, when it
#                      saw the frame; a restore steps the guest clock to the host's)
#   gpu-hook prepared-retake
#                      the same retake, started while the VM's GPU is still coming up: the
#                      container exec and the console's 'gpu status' happen first, then the
#                      hook prints 'prepared' and waits for a line 'go' on its input, which
#                      fc-agent writes once the GPU may be used. Input that ends without 'go'
#                      takes nothing up and fails. The image label dev.fcvm.gpu-hook-prepared
#                      tells fc-agent the hook has this action.
#
# No emulator started is not an error: there is nothing to let go of. An emulator that was
# started and exited fails a retake (the phone is gone) but not a release. Each call's
# output is also appended to /tmp/gpu-hook.log.
set -euo pipefail
# The test (scripts/phone/test-gpu-hook.sh) points these at stubs.
ADB=${GPU_HOOK_ADB:-/android/platform-tools/adb}
STATE=${GPU_HOOK_STATE:-/tmp}
exec > >(tee -a "$STATE/gpu-hook.log") 2>&1
log_tee=$!
# `podman exec`, which runs the hook, ends the session's other processes once the hook exits:
# close the pipe and wait for tee, or the last lines may never reach the log.
trap 'exec >&- 2>&-; wait "$log_tee" 2> /dev/null || true' EXIT
ms() { date +%s%3N; }
console() { timeout 30 "$ADB" emu "$@" | tr -d '\r'; }
. "$(dirname "$0")/phone-proc.sh"
# Whether an emulator was started (phone.sh writes its pid), and whether it still runs: one
# that exited is not running, reaped or not.
started() { [ -f "$STATE/emulator.pid" ]; }
running() { started && alive "$(cat "$STATE/emulator.pid")"; }
# The phone streamer (phone.sh serve) holds a CUDA context on the GPU: stop it before the
# release, and keep phone.sh's loop from starting it again until the retake. The loop checks
# the hold file and starts the streamer under streamer.lock, so taking the lock here means a
# streamer is either not started yet (and will see the hold) or started and named in
# streamer.pid (and is stopped here).
hold_streamer() {
  local pid
  exec 8> "$STATE/streamer.lock"
  flock 8
  touch "$STATE/streamer.hold"
  pid=$(cat "$STATE/streamer.pid" 2> /dev/null || true)
  stop_procs "$pid" phone-streamer
  flock -u 8
  exec 8>&-
}
free_streamer() { rm -f "$STATE/streamer.hold"; }

case "${1:-}" in
release)
  hold_streamer
  running || { started && echo "the emulator exited: nothing to let go of" || echo "no emulator running"; exit 0; }
  out=$(console gpu release)
  echo "$out"
  grep -q '^released_ms=' <<< "$out"
  ;;
retake | prepared-retake)
  # prepared-retake: nothing that uses the GPU, the streamer included, starts before 'go'
  go() {
    [ "$1" = prepared-retake ] || return 0
    echo prepared
    local line
    IFS= read -r line || { echo "the input ended before 'go': nothing taken up"; exit 1; }
    [ "$line" = go ] || { echo "expected 'go' on the input, read '$line'"; exit 1; }
  }
  # an emulator that exited leaves no phone to take the GPU up for: the restore fails
  started || { echo "no emulator running"; go "$1"; free_streamer; exit 0; }
  running || { echo "the emulator (pid $(cat "$STATE/emulator.pid")) exited: no phone to take the GPU up for"; exit 1; }
  # Only an answer of "held" means there is nothing to take up again; a console that
  # does not answer is an error, or a released phone would stay paused.
  status=$(console gpu status) || { echo "the emulator's console did not answer 'gpu status'"; exit 1; }
  case "$(head -1 <<< "$status")" in
  released) ;;
  held) echo "the emulator holds the GPU"; go "$1"; free_streamer; exit 0 ;;
  *) echo "unexpected 'gpu status' answer: $status"; exit 1 ;;
  esac
  go "$1"
  t0=$(mono_ms)
  out=$(console gpu retake)
  echo "$out"
  grep -q '^retaken_ms=' <<< "$out"
  deadline=$(( t0 + ${FRAME_TIMEOUT_MS:-10000} ))
  while [ "$(mono_ms)" -lt "$deadline" ]; do
    if [ "$(console gpu frame | head -1)" = posted ]; then
      now=$(mono_ms)
      echo "first_frame_ms=$(( now - t0 )) first_frame_at_ms=$(ms)"
      free_streamer
      exit 0
    fi
    sleep 0.02
  done
  echo "the phone posted no frame within ${FRAME_TIMEOUT_MS:-10000} ms of the retake"
  exit 1
  ;;
*)
  echo "usage: gpu-hook release|retake|prepared-retake" >&2
  exit 2
  ;;
esac
