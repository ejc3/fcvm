{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "jsx": "react-jsx",
    "types": ["node"],
    "allowJs": false,
    "incremental": true,
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "app/**/*.ts", "app/**/*.tsx", "core/**/*.ts", "mock/**/*.ts", "e2e/**/*.ts", "scripts/**/*.ts", "*.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
