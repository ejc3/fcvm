{
  "name": "@fcvm-fleet/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev:mock": "node scripts/dev-mock.ts",
    "mock": "node mock/main.ts",
    "build": "next build",
    "start:mock": "node scripts/dev-mock.ts --prod",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit -p core/tsconfig.json && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test && playwright test -c playwright.phones.config.ts",
    "measure": "node scripts/measure.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "oxlint": "1.89.0",
    "oxlint-plugin-eslint": "1.89.0",
    "typescript": "7.1.0-beta",
    "vite": "8.1.6",
    "vitest": "5.0.3",
    "wrangler": "4.148.0",
    "ws": "8.22.0"
  },
  "packageManager": "pnpm@12.15.0"
}
