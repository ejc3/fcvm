{
  "name": "@fcvm-fleet/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev:mock": "node scripts/dev-mock.ts",
    "mock": "node mock/main.ts",
    "build": "next build",
    "start:mock": "node scripts/dev-mock.ts --prod",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p core/tsconfig.json && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "measure": "node scripts/measure.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.1.6",
    "vitest": "5.0.3",
    "ws": "8.22.0"
  },
  "pnpm": { "onlyBuiltDependencies": ["sharp"] }
}
