# The host agent. Enabled, and started only where a host's boot (the launch template's user
# data in ejc3/aws, fcvm-fleet.tf `fcvm_fleet_host_agent_args`) wrote its arguments to
# /etc/fcvm-fleet/agent.env: at the store's end when the file was there by then, otherwise
# by the user data's own `systemctl start`. The agent dials the coordinator
# (wss://fleet-api-stage.fcvm.dev/agent with the Access service token from
# fcvm-fleet/agent-access-token). The arguments are fleet/PROTOCOL.md, "Agent", "Running it".
[Unit]
Description=fcvm fleet agent: one GPU VM per slot this host owns
Requires=fcvm-fleet-vfio.service fcvm-fleet-store.service
After=fcvm-fleet-vfio.service fcvm-fleet-store.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/fcvm-fleet/agent.env

#
# It runs as root: each slot's VM gets its own public IPv6 address in fcvm's routed mode
# (--ipv6-prefix-from-imds), which needs root, and the agent refuses a prefix otherwise.
# The renderer image is in root's podman store and fcvm's config in /root/.config/fcvm
# (build.sh puts both there).
#
# /etc/fcvm-fleet/phone.env (written at build by warm-phone.sh) holds the phones' arguments
# (PHONE_AGENT_ARGS: the phone image, the AOSP build, the emulator, the app and the warm
# snapshot); the host's own arguments choose how many GPUs run phones (--phones N).
[Service]
EnvironmentFile=/etc/fcvm-fleet/agent.env
EnvironmentFile=-/etc/fcvm-fleet/phone.env
ExecStart=/usr/local/bin/fcvm fleet agent $FLEET_AGENT_ARGS $PHONE_AGENT_ARGS
LimitMEMLOCK=infinity
LimitNOFILE=65536
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
