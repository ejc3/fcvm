[Unit]
Description=fcvm fleet tile: the renderer on the instance's one GPU (HTTP on 127.0.0.1:8080, TLS by nginx on 443)
# Started without waiting for cloud-init. A unit with default dependencies is ordered after
# sysinit.target, and cloud-init's network stage (cloud-init.service) is ordered before
# sysinit.target, so it would start only once that stage is done (about 8 s into a tile's
# first boot). The renderer listens on 127.0.0.1 with host networking: it needs the local
# filesystems and the GPU, not an address. It also starts before D-Bus (dbus.socket is
# ordered after sysinit.target), so podman manages the container's cgroup itself
# (--cgroup-manager=cgroupfs): crun's systemd manager fails with "cannot open sd-bus".
# The renderer takes two threads per frame stream, so podman's default pids limit (2048)
# refused threads from about the 1,020th viewer (fleet/renderer/README.md, "Viewers per
# renderer"); --pids-limit gives it room for 16,000 streams, past what the CPU serves.
DefaultDependencies=no
After=local-fs.target systemd-tmpfiles-setup.service nvidia-persistenced.service
Wants=nvidia-persistenced.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
# The CDI spec lists /dev/nvidia-uvm-tools, which udev creates a moment after nvidia-persistenced
# is up; on a boot that prefetches its files podman reached it first ("failed to stat CDI host
# device", a 2 s restart on every boot measured 2026-10-28). Wait for it, at most 10 s.
ExecStartPre=/bin/sh -c 'for _ in $(seq 100); do [ -e /dev/nvidia-uvm-tools ] && exit 0; sleep 0.1; done; exit 1'
ExecStartPre=-/usr/bin/podman --cgroup-manager=cgroupfs rm -f renderer
ExecStart=/usr/bin/podman --cgroup-manager=cgroupfs run --rm --name renderer --network host --device nvidia.com/gpu=all --pids-limit=32768 -e PORT=8080 localhost/fcvm-renderer:fleet
ExecStop=/usr/bin/podman --cgroup-manager=cgroupfs stop -t 5 renderer
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
