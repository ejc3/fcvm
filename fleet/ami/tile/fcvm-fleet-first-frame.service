[Unit]
Description=fcvm fleet tile: record the renderer's first frame after boot
# Not after cloud-init, like the renderer it watches (fcvm-fleet-renderer.service).
DefaultDependencies=no
After=local-fs.target fcvm-fleet-renderer.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/fcvm-fleet/first-frame.sh

[Install]
WantedBy=multi-user.target
