[Unit]
Description=NVIDIA Persistence Daemon (keeps the GPU initialised between clients)
DefaultDependencies=no
After=systemd-modules-load.service systemd-udev-trigger.service
Before=fcvm-fleet-renderer.service shutdown.target
Conflicts=shutdown.target
# Its first start runs right after systemd-modules-load inserts the driver, and nvidia-modprobe
# failed there on every boot (exit 1, 6 ms in, before the kernel module had initialised), which
# left the renderer waiting 10 s for /dev/nvidia-uvm-tools. A retry a moment later succeeds.
StartLimitIntervalSec=30
StartLimitBurst=20

[Service]
Type=forking
# /dev/nvidia-uvm and /dev/nvidia-uvm-tools exist only once something asks for them, and
# the CDI spec lists them: create them before anything starts a container.
ExecStartPre=/usr/bin/nvidia-modprobe -u -c=0
ExecStart=/usr/bin/nvidia-persistenced --user root
# The GPU's application clocks (what a busy GPU runs its kernels at) to the board's maximum:
# a T4 defaults to 585 MHz against 1590, and the renderer, idle between frames, ran its frames
# at 585 (fleet/renderer/README.md, "GPU clocks"). A board without them fails the set and
# keeps its default; that is logged and does not fail the unit.
ExecStartPost=-/bin/sh -c 'nvidia-smi --query-gpu=index,clocks.max.memory,clocks.max.graphics --format=csv,noheader,nounits | while IFS=", " read -r i m g; do nvidia-smi -i "$i" -ac "$m,$g"; done'
ExecStopPost=/bin/rm -rf /var/run/nvidia-persistenced
Restart=on-failure
RestartSec=200ms

[Install]
WantedBy=multi-user.target
