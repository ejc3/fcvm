From 8a4a46837004abd735ebd8647cf2fab729910b41 Mon Sep 17 00:00:00 2001
From: ejc3 <ejc3@users.noreply.github.com>
Date: Mon, 9 Nov 2026 00:08:11 +0000
Subject: [PATCH] nfs: give a restored machine's NFSv4 clients identities of
 their own

A machine restored from a snapshot holds the snapshot's NFSv4 clients:
their owner identifiers, and the client ID, opens and locks the server gave
them. A second copy restored from the same snapshot holds the same, and the
server keeps one copy of that state, so when one copy closes a file the
other's open of it is gone and its next write fails with EBADF.

Writing /sys/fs/nfs/net/nfs_client/renew_identities gives every NFSv4 client
of the namespace a random salt, appended to its owner identifier, and sets
its state up again as after the server lost it: the state manager drops the
cached identifier, takes a new client ID under the salted one, and
re-establishes every open and lock outside a grace period. Each copy of the
machine then holds opens of its own. The salt keeps the identity apart from
the clients the machine creates after the restore, which take the namespace
identifier unchanged.

The identifier is replaced under nfs_client_lock, under which the client list
walk compares identifiers, by the state manager, which alone sends
SETCLIENTID and EXCHANGE_ID.
---
 fs/nfs/nfs4_fs.h          |  2 ++
 fs/nfs/nfs4proc.c         | 27 +++++++++++----
 fs/nfs/nfs4state.c        | 71 +++++++++++++++++++++++++++++++++++++++
 fs/nfs/sysfs.c            | 24 +++++++++++++
 include/linux/nfs_fs_sb.h |  3 ++
 5 files changed, 121 insertions(+), 6 deletions(-)

diff --git a/fs/nfs/nfs4_fs.h b/fs/nfs/nfs4_fs.h
index c34c89a..eab63a2 100644
--- a/fs/nfs/nfs4_fs.h
+++ b/fs/nfs/nfs4_fs.h
@@ -48,6 +48,7 @@ enum nfs4_client_state {
 	NFS4CLNT_RECALL_ANY_LAYOUT_READ,
 	NFS4CLNT_RECALL_ANY_LAYOUT_RW,
 	NFS4CLNT_DELEGRETURN_DELAYED,
+	NFS4CLNT_NEW_OWNER_ID,
 };
 
 #define NFS4_RENEW_TIMEOUT		0x01
@@ -503,6 +504,7 @@ extern void nfs_inode_find_state_and_recover(struct inode *inode,
 		const nfs4_stateid *stateid);
 extern int nfs4_state_mark_reclaim_nograce(struct nfs_client *, struct nfs4_state *);
 extern void nfs4_schedule_lease_recovery(struct nfs_client *);
+extern void nfs4_renew_client_identities(struct net *net);
 extern int nfs4_wait_clnt_recover(struct nfs_client *clp);
 extern int nfs4_client_recover_expired_lease(struct nfs_client *clp);
 extern void nfs4_schedule_state_manager(struct nfs_client *);
diff --git a/fs/nfs/nfs4proc.c b/fs/nfs/nfs4proc.c
index 84ba899..0c847c0 100644
--- a/fs/nfs/nfs4proc.c
+++ b/fs/nfs/nfs4proc.c
@@ -6515,13 +6515,17 @@ nfs4_get_uniquifier(struct nfs_client *clp, char *buf, size_t buflen)
 	return strlen(buf);
 }
 
+/* "/r" and the eight hex digits of a client's owner salt. */
+#define NFS4_OWNER_SALT_LEN	10
+
 static int
 nfs4_init_nonuniform_client_string(struct nfs_client *clp)
 {
 	char buf[NFS4_CLIENT_ID_UNIQ_LEN];
 	size_t buflen;
-	size_t len;
+	size_t len, used;
 	char *str;
+	u32 salt;
 
 	if (clp->cl_owner_id != NULL)
 		return 0;
@@ -6537,6 +6541,9 @@ nfs4_init_nonuniform_client_string(struct nfs_client *clp)
 	buflen = nfs4_get_uniquifier(clp, buf, sizeof(buf));
 	if (buflen)
 		len += buflen + 1;
+	salt = READ_ONCE(clp->cl_owner_salt);
+	if (salt)
+		len += NFS4_OWNER_SALT_LEN;
 
 	if (len > NFS4_OPAQUE_LIMIT + 1)
 		return -EINVAL;
@@ -6552,16 +6559,18 @@ nfs4_init_nonuniform_client_string(struct nfs_client *clp)
 
 	rcu_read_lock();
 	if (buflen)
-		scnprintf(str, len, "Linux NFSv4.0 %s/%s/%s",
+		used = scnprintf(str, len, "Linux NFSv4.0 %s/%s/%s",
 			  clp->cl_rpcclient->cl_nodename, buf,
 			  rpc_peeraddr2str(clp->cl_rpcclient,
 					   RPC_DISPLAY_ADDR));
 	else
-		scnprintf(str, len, "Linux NFSv4.0 %s/%s",
+		used = scnprintf(str, len, "Linux NFSv4.0 %s/%s",
 			  clp->cl_rpcclient->cl_nodename,
 			  rpc_peeraddr2str(clp->cl_rpcclient,
 					   RPC_DISPLAY_ADDR));
 	rcu_read_unlock();
+	if (salt)
+		scnprintf(str + used, len - used, "/r%08x", salt);
 
 	clp->cl_owner_id = str;
 	return 0;
@@ -6572,8 +6581,9 @@ nfs4_init_uniform_client_string(struct nfs_client *clp)
 {
 	char buf[NFS4_CLIENT_ID_UNIQ_LEN];
 	size_t buflen;
-	size_t len;
+	size_t len, used;
 	char *str;
+	u32 salt;
 
 	if (clp->cl_owner_id != NULL)
 		return 0;
@@ -6584,6 +6594,9 @@ nfs4_init_uniform_client_string(struct nfs_client *clp)
 	buflen = nfs4_get_uniquifier(clp, buf, sizeof(buf));
 	if (buflen)
 		len += buflen + 1;
+	salt = READ_ONCE(clp->cl_owner_salt);
+	if (salt)
+		len += NFS4_OWNER_SALT_LEN;
 
 	if (len > NFS4_OPAQUE_LIMIT + 1)
 		return -EINVAL;
@@ -6598,13 +6611,15 @@ nfs4_init_uniform_client_string(struct nfs_client *clp)
 		return -ENOMEM;
 
 	if (buflen)
-		scnprintf(str, len, "Linux NFSv%u.%u %s/%s",
+		used = scnprintf(str, len, "Linux NFSv%u.%u %s/%s",
 			  clp->rpc_ops->version, clp->cl_minorversion,
 			  buf, clp->cl_rpcclient->cl_nodename);
 	else
-		scnprintf(str, len, "Linux NFSv%u.%u %s",
+		used = scnprintf(str, len, "Linux NFSv%u.%u %s",
 			  clp->rpc_ops->version, clp->cl_minorversion,
 			  clp->cl_rpcclient->cl_nodename);
+	if (salt)
+		scnprintf(str + used, len - used, "/r%08x", salt);
 	clp->cl_owner_id = str;
 	return 0;
 }
diff --git a/fs/nfs/nfs4state.c b/fs/nfs/nfs4state.c
index 01179f7..198bc0e 100644
--- a/fs/nfs/nfs4state.c
+++ b/fs/nfs/nfs4state.c
@@ -2087,10 +2087,30 @@ static int nfs4_reclaim_lease(struct nfs_client *clp)
 	return 0;
 }
 
+/*
+ * Forget the client's owner identifier, so that the next SETCLIENTID or
+ * EXCHANGE_ID builds a new one with the client's owner salt. Called by the
+ * state manager, which alone sends those. A walk of the client list reads the
+ * identifier under nfs_client_lock, so it is replaced under that lock.
+ */
+static void nfs4_drop_owner_id(struct nfs_client *clp)
+{
+	struct nfs_net *nn = net_generic(clp->cl_net, nfs_net_id);
+	const char *old;
+
+	spin_lock(&nn->nfs_client_lock);
+	old = clp->cl_owner_id;
+	clp->cl_owner_id = NULL;
+	spin_unlock(&nn->nfs_client_lock);
+	kfree(old);
+}
+
 static int nfs4_purge_lease(struct nfs_client *clp)
 {
 	int status;
 
+	if (test_and_clear_bit(NFS4CLNT_NEW_OWNER_ID, &clp->cl_state))
+		nfs4_drop_owner_id(clp);
 	status = nfs4_establish_lease(clp);
 	if (status < 0)
 		return nfs4_handle_reclaim_lease_error(clp, status);
@@ -2397,6 +2417,57 @@ void nfs41_notify_server(struct nfs_client *clp)
 	nfs4_schedule_state_manager(clp);
 }
 
+/*
+ * Give the client a new owner identity and set up its state again under it,
+ * as when the server has lost the state: a new client ID, then every open and
+ * lock re-established outside a grace period.
+ */
+static void nfs4_renew_client_identity(struct nfs_client *clp)
+{
+	WRITE_ONCE(clp->cl_owner_salt, get_random_u32() | 1);
+	set_bit(NFS4CLNT_NEW_OWNER_ID, &clp->cl_state);
+	set_bit(NFS4CLNT_LEASE_EXPIRED, &clp->cl_state);
+	set_bit(NFS4CLNT_PURGE_STATE, &clp->cl_state);
+	clear_bit(NFS4CLNT_LEASE_CONFIRM, &clp->cl_state);
+	nfs4_state_start_reclaim_nograce(clp);
+	nfs4_schedule_state_manager(clp);
+}
+
+/**
+ * nfs4_renew_client_identities - give every NFSv4 client of a net namespace
+ * a new owner identity
+ * @net: the network namespace
+ *
+ * A machine restored from a snapshot holds the snapshot's NFSv4 clients, with
+ * their owner identities and the client ID, opens and locks the server gave
+ * them. Another copy of the machine restored from the same snapshot holds the
+ * same, and the server keeps one copy of that state: when one copy closes a
+ * file, the other's open of it is gone. Afterwards each client has an identity
+ * of its own, a random salt appended to its owner identifier, and holds its
+ * opens and locks under it, so each copy of the machine holds its own.
+ */
+void nfs4_renew_client_identities(struct net *net)
+{
+	struct nfs_net *nn = net_generic(net, nfs_net_id);
+	struct nfs_client *clp, *prev = NULL;
+
+	spin_lock(&nn->nfs_client_lock);
+	list_for_each_entry(clp, &nn->nfs_client_list, cl_share_link) {
+		if (clp->rpc_ops->version != 4 ||
+		    clp->cl_cons_state != NFS_CS_READY)
+			continue;
+		if (!refcount_inc_not_zero(&clp->cl_count))
+			continue;
+		spin_unlock(&nn->nfs_client_lock);
+		nfs_put_client(prev);
+		prev = clp;
+		nfs4_renew_client_identity(clp);
+		spin_lock(&nn->nfs_client_lock);
+	}
+	spin_unlock(&nn->nfs_client_lock);
+	nfs_put_client(prev);
+}
+
 static void nfs4_reset_all_state(struct nfs_client *clp)
 {
 	if (test_and_set_bit(NFS4CLNT_LEASE_EXPIRED, &clp->cl_state) == 0) {
diff --git a/fs/nfs/sysfs.c b/fs/nfs/sysfs.c
index ea6e616..8cf115a 100644
--- a/fs/nfs/sysfs.c
+++ b/fs/nfs/sysfs.c
@@ -135,8 +135,32 @@ static const void *nfs_netns_client_namespace(const struct kobject *kobj)
 static struct kobj_attribute nfs_netns_client_id = __ATTR(identifier,
 		0644, nfs_netns_identifier_show, nfs_netns_identifier_store);
 
+#if IS_BUILTIN(CONFIG_NFS_V4)
+/*
+ * Writing anything gives every NFSv4 client of the namespace a new owner
+ * identity and sets its state up again under it (nfs4_renew_client_identities).
+ */
+static ssize_t nfs_netns_renew_identities_store(struct kobject *kobj,
+		struct kobj_attribute *attr,
+		const char *buf, size_t count)
+{
+	struct nfs_netns_client *c = container_of(kobj,
+			struct nfs_netns_client,
+			kobject);
+
+	nfs4_renew_client_identities(c->net);
+	return count;
+}
+
+static struct kobj_attribute nfs_netns_client_renew_identities =
+	__ATTR(renew_identities, 0200, NULL, nfs_netns_renew_identities_store);
+#endif
+
 static struct attribute *nfs_netns_client_attrs[] = {
 	&nfs_netns_client_id.attr,
+#if IS_BUILTIN(CONFIG_NFS_V4)
+	&nfs_netns_client_renew_identities.attr,
+#endif
 	NULL,
 };
 ATTRIBUTE_GROUPS(nfs_netns_client);
diff --git a/include/linux/nfs_fs_sb.h b/include/linux/nfs_fs_sb.h
index 30ac384..12665a2 100644
--- a/include/linux/nfs_fs_sb.h
+++ b/include/linux/nfs_fs_sb.h
@@ -88,6 +88,9 @@ struct nfs_client {
 
 	/* Client owner identifier */
 	const char *		cl_owner_id;
+	/* Appended to the owner identifier once nfs4_renew_client_identities() gave the
+	 * client a new one: 0 until then. */
+	u32			cl_owner_salt;
 
 	u32			cl_cb_ident;	/* v4.0 callback identifier */
 	const struct nfs4_minor_version_ops *cl_mvops;
-- 
2.43.0

