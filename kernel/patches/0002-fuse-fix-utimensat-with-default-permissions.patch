From 905da9357cfef75e2aff9f61a320413b6f06dc11 Mon Sep 17 00:00:00 2001
From: ejc3 <ejc3@users.noreply.github.com>
Date: Fri, 6 Nov 2026 00:25:21 +0000
Subject: [PATCH] fuse: send FATTR_MTIME_NOW for utimensat(UTIME_NOW) with
 writeback cache

With the writeback cache enabled (trust_local_cmtime=true),
iattr_to_fattr() sends FATTR_ATIME_NOW but not FATTR_MTIME_NOW for
utimensat(UTIME_NOW). The FUSE server then receives an explicit mtime
instead of "set to now", and since setting an explicit timestamp
requires ownership, it returns EPERM to a non-owner that has write
permission, which POSIX allows to touch the file.

Send FATTR_MTIME_NOW when ATTR_TOUCH is set, regardless of the
writeback cache. Normal writes keep the writeback cache's local mtime.

An earlier version of this patch also added ATTR_FORCE in
fuse_do_setattr() for ATTR_TOUCH under default_permissions. That is not
needed: setattr_prepare() checks ownership only for ATTR_MTIME_SET,
ATTR_ATIME_SET and ATTR_TIMES_SET, and may_setattr() checks write
permission for ATTR_TOUCH before the filesystem is called.
---
 fs/fuse/dir.c | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/fs/fuse/dir.c b/fs/fuse/dir.c
index a013fad..1069f8e 100644
--- a/fs/fuse/dir.c
+++ b/fs/fuse/dir.c
@@ -1834,8 +1834,17 @@ static void iattr_to_fattr(struct mnt_idmap *idmap, struct fuse_conn *fc,
 		arg->valid |= FATTR_MTIME;
 		arg->mtime = iattr->ia_mtime.tv_sec;
 		arg->mtimensec = iattr->ia_mtime.tv_nsec;
-		if (!(ivalid & ATTR_MTIME_SET) && !trust_local_cmtime)
-			arg->valid |= FATTR_MTIME_NOW;
+		if (!(ivalid & ATTR_MTIME_SET)) {
+			/*
+			 * Send MTIME_NOW if not explicit timestamp AND either:
+			 * - writeback cache disabled (!trust_local_cmtime), OR
+			 * - this is utimensat(UTIME_NOW) (ATTR_TOUCH set)
+			 * The second case ensures POSIX compliance for touch ops
+			 * even with writeback cache enabled.
+			 */
+			if (!trust_local_cmtime || (ivalid & ATTR_TOUCH))
+				arg->valid |= FATTR_MTIME_NOW;
+		}
 	}
 	if ((ivalid & ATTR_CTIME) && trust_local_cmtime) {
 		arg->valid |= FATTR_CTIME;
-- 
